---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import TextLink from "@/components/TextLink.astro";
import { parseAuthErrorCode } from "@/lib/auth-errors";
import SignUpForm from "@/components/auth/SignUpForm";

const error = parseAuthErrorCode(Astro.url.searchParams.get("error"));
---

<Layout title="Rejestracja">
  <AuthShell title="Utwórz konto">
    <SignUpForm serverError={error} client:load />
    <p slot="footer">
      Masz już konto? <TextLink href="/auth/signin">Zaloguj się</TextLink>
    </p>
  </AuthShell>
</Layout>
