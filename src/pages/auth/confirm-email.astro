---
import { CircleCheck, MailCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import TextLink from "@/components/TextLink.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      title: "Konto utworzone",
      description: "Możesz się zalogować.",
    }
  : {
      title: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link potwierdzający. Kliknij go, aby aktywować konto.",
    };
const Icon = isAutoConfirmed ? CircleCheck : MailCheck;
---

<Layout title={content.title}>
  <AuthShell title={content.title} description={content.description}>
    <div class="flex size-12 items-center justify-center rounded-pill bg-muted text-primary">
      <Icon className="size-6" aria-hidden="true" />
    </div>
    <p slot="footer">
      <TextLink href="/auth/signin">Przejdź do logowania</TextLink>
    </p>
  </AuthShell>
</Layout>
