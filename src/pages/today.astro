---
import AddTaskFromTodayDialog from "@/components/today/AddTaskFromTodayDialog";
import CloseMilestoneButton from "@/components/today/CloseMilestoneButton";
import DueChip from "@/components/today/DueChip.astro";
import RestoreDeferredButton from "@/components/today/RestoreDeferredButton";
import TodayTaskActions from "@/components/today/TodayTaskActions";
import AppLayout from "@/layouts/AppLayout.astro";
import { formatDate, formatRecurrence, plural } from "@/lib/format";
import { logError } from "@/lib/log";
import { getTaskTargets, getToday } from "@/lib/services/today";
import { createClient } from "@/lib/supabase";
import { dueChip, formatTodayHeading, todayInWarsaw } from "@/lib/today";
import { formatWeekdayFrom } from "@/lib/weekdays";
import type { TaskTargetProject, TodayView } from "@/types";

export const prerender = false;

// The list depends on the current day, so it must not come back from a cache (e.g. bfcache) after midnight.
Astro.response.headers.set("Cache-Control", "no-store");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const today = todayInWarsaw();

let view: TodayView = { routines: [], skipped: [], tasks: [], milestones: [], deferred: [] };
let targets: TaskTargetProject[] = [];
let unavailable: string | null = null;
if (!supabase) {
  unavailable = "Aplikacja nie jest teraz dostępna. Spróbuj ponownie za chwilę.";
} else {
  try {
    [view, targets] = await Promise.all([getToday(supabase, today), getTaskTargets(supabase)]);
  } catch (error) {
    logError("today-list", error);
    unavailable = "Nie udało się wczytać listy na dziś. Odśwież stronę za chwilę.";
  }
}

const rows = view.tasks.map((task) => ({ task, chip: dueChip(task.due_date, today) }));
const milestoneRows = view.milestones.map((milestone) => ({ milestone, chip: dueChip(milestone.due_date, today) }));
// Routines count as items but have no due date, so they are never overdue.
const itemCount = view.routines.length + view.tasks.length + view.milestones.length;
// Skipped rows are information, not items to do, but they still keep the list from reading as empty.
const hasRows = itemCount + view.skipped.length > 0;
const overdueCount =
  rows.filter((row) => row.chip.tone === "overdue").length +
  milestoneRows.filter((row) => row.chip.tone === "overdue").length;
const milestoneCount = view.milestones.length;
const summary = [
  `${itemCount} ${plural(itemCount, ["pozycja", "pozycje", "pozycji"])}`,
  overdueCount > 0 ? `${overdueCount} po terminie` : null,
  milestoneCount > 0 ? `${milestoneCount} milestone do zamknięcia` : null,
]
  .filter((part) => part !== null)
  .join(" · ");
---

<AppLayout title="Dziś" current="today">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <p class="type-eyebrow text-muted-foreground">Dziś</p>
      <h1 class="type-display text-foreground">{formatTodayHeading(today)}</h1>
      {!unavailable && itemCount > 0 && <p class="type-meta mt-1 text-muted-foreground tabular-nums">{summary}</p>}
    </div>
    {!unavailable && <AddTaskFromTodayDialog client:load targets={targets} />}
  </div>

  {unavailable ? (
    <p role="alert" class="type-quote mt-8 text-destructive-ink">
      {unavailable}
    </p>
  ) : (
    <>
      {!hasRows ? (
        <div class="mt-8 flex flex-col items-start gap-4 rounded-md border border-border bg-card p-6 shadow-card">
          <p class="type-quote text-muted-foreground">Na dziś nic do zrobienia.</p>
          <a href="/projects" class="type-button text-foreground underline">
            Projekty
          </a>
        </div>
      ) : (
        <ul class="mt-8 divide-y divide-border rounded-md border border-border bg-card shadow-card">
          {view.routines.map((routine) => (
            <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="type-task break-words text-foreground">{routine.title}</p>
                <p class="type-meta break-words text-muted-foreground">
                  <a
                    href={`/projects/${routine.project.id}`}
                    class="rounded-sm underline outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    {routine.project.name}
                  </a>
                  {" · "}
                  {routine.milestone.name}
                  {` · ${formatRecurrence({ intervalDays: routine.interval_days, weekdays: routine.weekdays })}`}
                  {routine.moved_from && ` · przeniesione ${formatWeekdayFrom(routine.moved_from)}`}
                </p>
              </div>
              <div class="flex min-w-0 shrink-0 flex-col items-start gap-2 sm:items-end">
                <TodayTaskActions
                  client:load
                  recurring
                  projectId={routine.project.id}
                  milestoneId={routine.milestone.id}
                  taskId={routine.id}
                  title={routine.title}
                  canMove={routine.can_move}
                />
              </div>
            </li>
          ))}
          {view.skipped.map((skipped) => (
            <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="type-task break-words text-foreground">{skipped.title}</p>
                <p class="type-meta break-words text-muted-foreground">
                  <a
                    href={`/projects/${skipped.project.id}`}
                    class="rounded-sm underline outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    {skipped.project.name}
                  </a>
                  {" · "}
                  {skipped.milestone.name}
                  {` · ${formatRecurrence({ intervalDays: skipped.interval_days, weekdays: skipped.weekdays })}`}
                </p>
              </div>
              <div class="flex min-w-0 shrink-0 flex-col items-start gap-2 sm:items-end">
                <span class="type-meta inline-flex shrink-0 items-center gap-1 self-start rounded-pill bg-warning-soft px-2 text-warning-ink">
                  <svg
                    class="size-3 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                  </svg>
                  Pominięte wczoraj
                </span>
              </div>
            </li>
          ))}
          {rows.map(({ task, chip }) => (
            <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="type-task break-words text-foreground">{task.title}</p>
                <p class="type-meta break-words text-muted-foreground">
                  <a
                    href={`/projects/${task.project.id}`}
                    class="rounded-sm underline outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    {task.project.name}
                  </a>
                  {" · "}
                  {task.milestone.name}
                  {task.status === "partial" && " · częściowo"}
                </p>
              </div>
              <div class="flex min-w-0 shrink-0 flex-col items-start gap-2 sm:items-end">
                <DueChip chip={chip} />
                {task.status !== "done" && (
                  <TodayTaskActions
                    client:load
                    projectId={task.project.id}
                    milestoneId={task.milestone.id}
                    taskId={task.id}
                    title={task.title}
                    status={task.status}
                  />
                )}
              </div>
            </li>
          ))}
          {milestoneRows.map(({ milestone, chip }) => (
            <li class="flex flex-col gap-2 bg-accent px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="font-serif text-xl font-medium break-words text-foreground">{milestone.name}</p>
                <p class="type-meta flex flex-wrap items-center gap-x-2 gap-y-1 break-words text-muted-foreground">
                  <a
                    href={`/projects/${milestone.project.id}`}
                    class="rounded-sm underline outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    {milestone.project.name}
                  </a>
                  <span aria-hidden="true">·</span>
                  <span class="tabular-nums">{formatDate(milestone.due_date)}</span>
                  {chip.tone !== "date" && chip.tone !== "none" && <DueChip chip={chip} />}
                </p>
                <p class="type-meta text-muted-foreground">Wszystkie zadania zrobione — milestone do zamknięcia</p>
              </div>
              <div class="flex shrink-0 flex-wrap items-start gap-2 self-start">
                <CloseMilestoneButton
                  client:load
                  projectId={milestone.project.id}
                  milestoneId={milestone.id}
                  milestoneName={milestone.name}
                />
                <a
                  href={`/projects/${milestone.project.id}`}
                  aria-label={`Otwórz projekt ${milestone.project.name}`}
                  class="type-button inline-flex h-8 items-center rounded-pill px-1 text-foreground underline outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  Otwórz projekt
                </a>
              </div>
            </li>
          ))}
        </ul>
      )}
      {view.deferred.length > 0 && (
        <details data-deferred-details class="mt-4 rounded-md border border-border bg-card shadow-card">
          <summary class="type-meta cursor-pointer rounded-md px-4 py-3 text-muted-foreground tabular-nums outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background">
            {`Przeniesione na później: ${view.deferred.length}`}
          </summary>
          <ul class="divide-y divide-border border-t border-border">
            {view.deferred.map((task) => (
              <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <div class="min-w-0">
                  <p class="type-task break-words text-foreground">{task.title}</p>
                  <p class="type-meta break-words text-muted-foreground">
                    <a
                      href={`/projects/${task.project.id}`}
                      class="rounded-sm underline outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                    >
                      {task.project.name}
                    </a>
                    {` · ${task.milestone.name} · wróci ${formatDate(task.deferred_until)}`}
                  </p>
                </div>
                <RestoreDeferredButton
                  client:load
                  projectId={task.project.id}
                  milestoneId={task.milestone.id}
                  taskId={task.id}
                  title={task.title}
                />
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  )}
</AppLayout>

<script>
  // A restore reloads the page; keep the deferred list open across the reload (sessionStorage may be unavailable).
  const KEY = "today-deferred-open";
  const details = document.querySelector<HTMLDetailsElement>("[data-deferred-details]");
  if (details) {
    try {
      details.open = sessionStorage.getItem(KEY) === "1";
    } catch {
      // Storage blocked: the list stays collapsed.
    }
    details.addEventListener("toggle", () => {
      try {
        sessionStorage.setItem(KEY, details.open ? "1" : "0");
      } catch {
        // Storage blocked: nothing to remember.
      }
    });
  }
</script>
