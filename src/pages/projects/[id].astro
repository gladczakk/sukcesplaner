---
import AppLayout from "@/layouts/AppLayout.astro";
import DeleteProjectDialog from "@/components/projects/DeleteProjectDialog";
import MilestoneFormDialog from "@/components/projects/MilestoneFormDialog";
import MilestoneRowActions from "@/components/projects/MilestoneRowActions";
import ProjectFormDialog from "@/components/projects/ProjectFormDialog";
import TaskFormDialog from "@/components/projects/TaskFormDialog";
import TaskRowActions from "@/components/projects/TaskRowActions";
import { formatDate, formatTimestamp, plural } from "@/lib/format";
import { LIFE_AREA_LABELS } from "@/lib/life-areas";
import { logError } from "@/lib/log";
import { listMilestones } from "@/lib/services/milestones";
import { getProject, getProjectCounts } from "@/lib/services/projects";
import { createClient } from "@/lib/supabase";
import { projectIdSchema } from "@/lib/validation/project";
import type { MilestoneListItem, Project } from "@/types";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const parsedId = projectIdSchema.safeParse(Astro.params.id);

let project: Project | null = null;
let counts = { milestones: 0, tasks: 0 };
let unavailable: string | null = null;
let milestones: MilestoneListItem[] = [];
let milestonesError: string | null = null;
if (!supabase) {
  unavailable = "Aplikacja nie jest teraz dostępna. Spróbuj ponownie za chwilę.";
} else if (parsedId.success) {
  try {
    project = await getProject(supabase, parsedId.data);
    if (project) counts = await getProjectCounts(supabase, project.id);
  } catch (error) {
    logError("project-view", error);
    unavailable = "Nie udało się wczytać projektu. Odśwież stronę za chwilę.";
  }
  if (project) {
    try {
      milestones = await listMilestones(supabase, project.id);
    } catch (error) {
      logError("project-milestones", error);
      milestonesError = "Nie udało się wczytać milestonów. Odśwież stronę za chwilę.";
    }
  }
}

const notFound = !unavailable && !project;
if (notFound) Astro.response.status = 404;
---

<AppLayout title={project ? project.name : notFound ? "Nie znaleziono projektu" : "Projekt"} current="projects">
  {unavailable ? (
    <div class="flex flex-col items-start gap-4">
      <p role="alert" class="type-quote text-destructive-ink">
        {unavailable}
      </p>
      <a href="/projects" class="type-button text-foreground underline">
        Projekty
      </a>
    </div>
  ) : project ? (
    <>
      <a
        href="/projects"
        class="type-button -ml-1 inline-flex h-8 items-center rounded-pill px-1 text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        Projekty
      </a>
      <div class="mt-2 grid gap-8 lg:grid-cols-3">
        <div class="min-w-0 lg:col-span-2">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="type-eyebrow text-muted-foreground">Projekt · {LIFE_AREA_LABELS[project.life_area]}</p>
              <h1 class="type-display mt-1 break-words text-foreground">{project.name}</h1>
            </div>
            <ProjectFormDialog
              mode="edit"
              project={{
                id: project.id,
                name: project.name,
                description: project.description,
                life_area: project.life_area,
                due_date: project.due_date,
              }}
              client:load
            />
          </div>
          {project.description && (
            <p class="type-quote mt-1 break-words whitespace-pre-line text-muted-foreground">{project.description}</p>
          )}
          <p class="type-body mt-3 text-muted-foreground tabular-nums">
            Termin projektu: <span class="font-medium text-foreground">{formatDate(project.due_date)}</span>
          </p>
          <section class="mt-8" aria-labelledby="milestones-heading">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <h2 id="milestones-heading" class="type-section text-foreground">
                Milestony
              </h2>
              <MilestoneFormDialog mode="create" projectId={project.id} projectDueDate={project.due_date} client:load />
            </div>
            {milestonesError ? (
              <p role="alert" class="type-quote mt-3 text-destructive-ink">
                {milestonesError}
              </p>
            ) : milestones.length === 0 ? (
              <p class="type-quote mt-3 rounded-md border border-dashed border-border p-4 text-muted-foreground">
                Ten projekt nie ma jeszcze milestonów.
              </p>
            ) : (
              <ol class="mt-3 flex flex-col gap-3">
                {milestones.map((milestone) => (
                  <li class="flex flex-col gap-4 rounded-md border border-border bg-card p-4 shadow-card">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                      <div class="flex min-w-0 items-start gap-3">
                        <span
                          aria-hidden="true"
                          class:list={[
                            "mt-2 size-3 shrink-0 rotate-45 border border-primary",
                            milestone.completed_at ? "bg-primary" : "bg-card",
                          ]}
                        />
                        <div class="min-w-0">
                          <p
                            class:list={[
                              "type-section break-words",
                              milestone.completed_at ? "text-muted-foreground" : "text-foreground",
                            ]}
                          >
                            {milestone.name}
                          </p>
                          <p class="type-meta mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-muted-foreground tabular-nums">
                            <span>{formatDate(milestone.due_date)}</span>
                            <span>
                              {milestone.task_count} {plural(milestone.task_count, ["zadanie", "zadania", "zadań"])}
                            </span>
                            {milestone.completed_at && (
                              <span class="inline-flex items-center gap-1 rounded-pill bg-success-soft px-2 text-success-ink">
                                <svg
                                  class="size-3 shrink-0"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  aria-hidden="true"
                                >
                                  <path d="M20 6 9 17l-5-5" />
                                </svg>
                                zamknięty {formatTimestamp(milestone.completed_at)}
                              </span>
                            )}
                          </p>
                        </div>
                      </div>
                      <MilestoneRowActions
                        projectId={project.id}
                        projectDueDate={project.due_date}
                        milestone={{
                          id: milestone.id,
                          name: milestone.name,
                          due_date: milestone.due_date,
                          completed_at: milestone.completed_at,
                        }}
                        taskCount={milestone.task_count}
                        client:load
                      />
                    </div>
                    <div class="flex flex-col gap-3 border-t border-border pt-3">
                      {milestone.tasks.length === 0 ? (
                        <p class="type-meta text-muted-foreground">Brak zadań w tym milestonie.</p>
                      ) : (
                        <ul class="flex flex-col gap-2" aria-label={`Zadania milestona ${milestone.name}`}>
                          {milestone.tasks.map((task) => (
                            <li class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                              <div class="min-w-0">
                                <p
                                  class:list={[
                                    "type-body break-words",
                                    task.status === "done" ? "text-muted-foreground line-through" : "text-foreground",
                                  ]}
                                >
                                  {task.title}
                                </p>
                                <p class="type-meta text-muted-foreground tabular-nums">
                                  {task.due_date ? formatDate(task.due_date) : "bez terminu"}
                                </p>
                              </div>
                              <TaskRowActions
                                projectId={project.id}
                                milestone={{ id: milestone.id, name: milestone.name, due_date: milestone.due_date }}
                                task={{ id: task.id, title: task.title, due_date: task.due_date, status: task.status }}
                                client:load
                              />
                            </li>
                          ))}
                        </ul>
                      )}
                      <div class="flex flex-wrap items-center gap-3">
                        <TaskFormDialog
                          mode="create"
                          projectId={project.id}
                          milestone={{ id: milestone.id, name: milestone.name, due_date: milestone.due_date }}
                          disabled={milestone.completed_at !== null}
                          client:load
                        />
                        {milestone.completed_at && (
                          <p id={`closed-milestone-hint-${milestone.id}`} class="type-meta text-muted-foreground">
                            Otwórz milestone, aby dodać zadanie.
                          </p>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </section>
        </div>
        <aside class="flex min-w-0 flex-col gap-4" aria-label="Szczegóły projektu">
          <div class="rounded-md border border-border bg-card p-4 shadow-card">
            <h2 class="type-section text-foreground">Szczegóły</h2>
            <dl class="type-body mt-3 flex flex-col gap-2">
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Obszar życia</dt>
                <dd class="text-foreground">{LIFE_AREA_LABELS[project.life_area]}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Termin</dt>
                <dd class="text-foreground tabular-nums">{formatDate(project.due_date)}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Utworzono</dt>
                <dd class="text-foreground tabular-nums">{formatTimestamp(project.created_at)}</dd>
              </div>
            </dl>
          </div>
          <DeleteProjectDialog projectId={project.id} projectName={project.name} counts={counts} client:load />
        </aside>
      </div>
    </>
  ) : (
    <div class="flex flex-col items-start gap-4">
      <h1 class="type-display text-foreground">Nie znaleziono projektu</h1>
      <a href="/projects" class="type-button text-foreground underline">
        Wróć do projektów
      </a>
    </div>
  )}
</AppLayout>
