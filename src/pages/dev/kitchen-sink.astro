---
import AppLayout from "@/layouts/AppLayout.astro";
import NavLink from "@/components/NavLink.astro";
import Banner from "@/components/Banner.astro";
import Chip from "@/components/Chip.astro";
import TaskRow from "@/components/TaskRow.astro";
import TextLink from "@/components/TextLink.astro";
import { Button } from "@/components/ui/button";
import { InlineError } from "@/components/ui/inline-error";
import { LoaderCircle, Repeat } from "lucide-react";
import SignInForm from "@/components/auth/SignInForm";
import SignUpForm from "@/components/auth/SignUpForm";

export const prerender = false;

// Tylko DEV: poza trybem deweloperskim strona nie istnieje.
const blocked = !import.meta.env.DEV;
if (blocked) {
  Astro.response.status = 404;
}

// Tokeny rozwiązują się per element, więc wrapper z klasą `dark` pokazuje ciemne wartości.
const themes = [
  { label: "Jasny", class: "" },
  { label: "Ciemny", class: "dark bg-background text-foreground rounded-md border border-border p-4" },
];

// Wymuszone klasami warianty interakcji (symulują stan, nie wywołują go).
const hoverSim = "[&_a]:bg-accent"; // symuluje hover
const focusSim = "[&_a]:ring-2 [&_a]:ring-ring [&_a]:ring-offset-2 [&_a]:ring-offset-background"; // symuluje focus-visible
const bannerFocusSim = "[&_a]:ring-2 [&_a]:ring-ring"; // symuluje focus-visible linku w banerze
---

{!blocked && (
  <AppLayout title="Kitchen sink" current="today">
    {/* Strona porównawcza: kolumna "Jasny" ma być jasna niezależnie od motywu systemu, "Ciemny" wymusza własny wrapper. */}
    <script is:inline>
      document.documentElement.classList.remove("dark");
    </script>
    <h1 class="type-section mb-6">Kitchen sink</h1>
    <div class="grid gap-6 md:grid-cols-2">
      {themes.map((theme) => (
        <div class:list={theme.class}>
          <p class="type-eyebrow mb-4 text-muted-foreground">{theme.label}</p>

          <section class="mb-8">
            <h2 class="type-section mb-3">NavLink</h2>
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">default</p>
                <NavLink href="/today">Dziś</NavLink>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">aktywna</p>
                <NavLink href="/today" current>
                  Dziś
                </NavLink>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">hover</p>
                <div class:list={hoverSim}>
                  <NavLink href="/today">Dziś</NavLink>
                </div>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">focus-visible</p>
                <div class:list={focusSim}>
                  <NavLink href="/today">Dziś</NavLink>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">Banner</h2>
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">error</p>
                <Banner>
                  <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
                  <a href="/dev/kitchen-sink">Zobacz instrukcję konfiguracji</a>.
                </Banner>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">focus-visible (link)</p>
                <div class:list={bannerFocusSim}>
                  <Banner>
                    <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
                    <a href="/dev/kitchen-sink">Zobacz instrukcję konfiguracji</a>.
                  </Banner>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">TaskRow</h2>
            <ul class="divide-y divide-border rounded-md border border-border bg-card shadow-card">
              <TaskRow>
                <Fragment slot="title">Zadanie z terminem</Fragment>
                <Fragment slot="meta">
                  <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                  {" · Milestone"}
                </Fragment>
                <Fragment slot="end">
                  <Chip tone="tomorrow" label="jutro" />
                  <Button variant="secondary" size="sm">
                    Zrobione
                  </Button>
                </Fragment>
              </TaskRow>
              <TaskRow>
                <Fragment slot="title">Rutyna</Fragment>
                <Fragment slot="meta">
                  <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                  {" · Milestone · "}
                  <Repeat className="inline size-3.5 shrink-0 align-text-bottom" aria-hidden="true" />
                  {" Co 2 dni"}
                </Fragment>
                <Fragment slot="end">
                  <Button variant="secondary" size="sm">
                    Zrobione
                  </Button>
                  <Button variant="ghost" size="sm">
                    Na jutro
                  </Button>
                </Fragment>
              </TaskRow>
              <TaskRow>
                <Fragment slot="title">Pominięte zadanie</Fragment>
                <Fragment slot="meta">
                  <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                  {" · Milestone · Co 2 dni"}
                </Fragment>
                <Fragment slot="end">
                  <Chip tone="skipped" label="Pominięte wczoraj" />
                </Fragment>
              </TaskRow>
              <TaskRow variant="milestone">
                <Fragment slot="title">Milestone do zamknięcia</Fragment>
                <Fragment slot="meta">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                    <span aria-hidden="true">·</span>
                    <span class="tabular-nums">12 paź</span>
                    <Chip tone="overdue" label="wczoraj" />
                  </span>
                  <span class="block">Wszystkie zadania zrobione — milestone do zamknięcia</span>
                </Fragment>
                <Fragment slot="end">
                  <Button variant="secondary" size="sm">
                    Zamknij milestone
                  </Button>
                  <TextLink href="/dev/kitchen-sink" standalone>
                    Otwórz projekt
                  </TextLink>
                </Fragment>
              </TaskRow>
            </ul>
            <div class="mt-3 rounded-md border border-border bg-card p-4 shadow-card">
              <ul class="flex flex-col gap-2">
                <TaskRow variant="compact">
                  <Fragment slot="title">Zadanie w milestonie</Fragment>
                  <Fragment slot="meta">
                    <span class="tabular-nums">12 paź</span>
                  </Fragment>
                  <Fragment slot="end">
                    <Button variant="secondary" size="sm">
                      Edytuj
                    </Button>
                  </Fragment>
                </TaskRow>
                <TaskRow variant="compact" done>
                  <Fragment slot="title">Zadanie zrobione</Fragment>
                  <Fragment slot="meta">
                    <span>bez terminu</span>
                  </Fragment>
                  <Fragment slot="end">
                    <Button variant="ghost" size="sm">
                      Edytuj
                    </Button>
                  </Fragment>
                </TaskRow>
              </ul>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">Chip</h2>
            <div class="flex flex-wrap gap-2">
              <Chip tone="overdue" label="2 dni po terminie" />
              <Chip tone="today" label="dziś" />
              <Chip tone="tomorrow" label="jutro" />
              <Chip tone="soon" label="za 3 dni" />
              <Chip tone="date" label="12 paź" />
              <Chip tone="none" label="bez terminu" />
              <Chip tone="skipped" label="Pominięte wczoraj" />
              <Chip tone="done" label="zamknięty 22 paź" />
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">TextLink</h2>
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">default</p>
                <p class="type-meta text-muted-foreground">
                  Projekt tekstowy: <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                </p>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">hover</p>
                <p class="type-meta text-muted-foreground [&_a]:text-foreground">
                  Projekt tekstowy: <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                </p>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">focus-visible</p>
                <p class:list={["type-meta text-muted-foreground", focusSim]}>
                  Projekt tekstowy: <TextLink href="/dev/kitchen-sink">Projekt</TextLink>
                </p>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">standalone</p>
                <TextLink href="/dev/kitchen-sink" standalone>
                  Otwórz projekt
                </TextLink>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">standalone, focus-visible</p>
                <div class:list={focusSim}>
                  <TextLink href="/dev/kitchen-sink" standalone>
                    Otwórz projekt
                  </TextLink>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">InlineError</h2>
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">alert</p>
                <InlineError>Nie udało się zapisać zmian. Spróbuj ponownie.</InlineError>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">status</p>
                <InlineError role="status">Nie udało się wczytać projektów. Odśwież stronę za chwilę.</InlineError>
              </div>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">Button</h2>
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">aria-disabled</p>
                <Button variant="secondary" aria-disabled="true">
                  Nieaktywny
                </Button>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">default</p>
                <Button variant="secondary">Aktywny</Button>
              </div>
            </div>
          </section>

          <section class="mb-8">
            <h2 class="type-section mb-3">Auth</h2>
            {/* AuthShell renderuje <main min-h-screen>, więc karta jest odtworzona z tych samych klas tokenowych. */}
            <div class="flex flex-col gap-3">
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">karta, logowanie (default)</p>
                <div class="w-full max-w-sm rounded-md border border-border bg-card p-8 shadow-card">
                  <h3 class="type-display text-foreground">Zaloguj się</h3>
                  <div class="mt-6">
                    <SignInForm idPrefix={`${theme.label}-signin-`} client:load />
                  </div>
                  <div class="type-meta mt-6 text-muted-foreground">
                    <p>
                      Nie masz konta? <TextLink href="/dev/kitchen-sink">Utwórz konto</TextLink>
                    </p>
                  </div>
                </div>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">logowanie, błąd serwera</p>
                <div class="w-full max-w-sm rounded-md border border-border bg-card p-8 shadow-card">
                  <SignInForm serverError="invalid_credentials" idPrefix={`${theme.label}-signin-error-`} client:load />
                </div>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">rejestracja, błąd serwera</p>
                <div class="w-full max-w-sm rounded-md border border-border bg-card p-8 shadow-card">
                  <h3 class="type-display text-foreground">Utwórz konto</h3>
                  <div class="mt-6">
                    <SignUpForm
                      serverError="user_already_exists"
                      idPrefix={`${theme.label}-signup-error-`}
                      client:load
                    />
                  </div>
                </div>
              </div>
              <div>
                <p class="type-eyebrow mb-1 text-muted-foreground">przycisk pending (disabled)</p>
                <Button type="button" disabled className="w-full max-w-sm">
                  <LoaderCircle className="animate-spin" aria-hidden="true" />
                  Logowanie…
                </Button>
              </div>
            </div>
            <p class="type-meta mt-3 text-muted-foreground">
              N/A: error pola — powstaje dopiero po wysłaniu formularza; pending to statyczny odpowiednik (useFormStatus
              nie da się wymusić)
            </p>
          </section>

          <p class="type-meta text-muted-foreground">
            N/A: hover, focus-visible, empty, loading — komponenty nie mają tych stanów (fokus linków i przycisków
            sprawdzany ręcznie); disabled pokazany tylko dla Button
          </p>
        </div>
      ))}
    </div>
  </AppLayout>
)}
