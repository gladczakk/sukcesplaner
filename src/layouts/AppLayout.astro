---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import NavLink from "@/components/NavLink.astro";

interface Props {
  title?: string;
  current?: "today" | "projects";
}

const { title, current } = Astro.props;
const { user } = Astro.locals;
---

<Layout title={title}>
  <header class="border-b border-border bg-card">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 md:px-6">
      <a
        href="/today"
        class="order-1 rounded-sm font-serif text-xl font-semibold text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        SukcesPlaner
      </a>
      <nav class="order-3 flex w-full items-center gap-2 md:order-2 md:w-auto" aria-label="Główna nawigacja">
        <NavLink href="/today" current={current === "today"}>
          Dziś
        </NavLink>
        <NavLink href="/projects" current={current === "projects"}>
          Projekty
        </NavLink>
      </nav>
      <div class="order-2 ml-auto flex min-w-0 items-center gap-3 md:order-3">
        {user && <span class="type-meta hidden truncate text-muted-foreground md:inline">{user.email}</span>}
        <form method="POST" action="/api/auth/signout">
          <Button type="submit" variant="ghost" size="sm">
            Wyloguj
          </Button>
        </form>
      </div>
    </div>
  </header>
  <main class="mx-auto w-full max-w-5xl px-4 py-6 md:px-6 md:py-8">
    <slot />
  </main>
</Layout>
