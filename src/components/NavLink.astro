---
interface Props {
  href: string;
  current?: boolean;
}

const { href, current = false } = Astro.props;
---

<a
  href={href}
  aria-current={current ? "page" : undefined}
  class:list={[
    "type-button inline-flex min-h-10 items-center justify-center rounded-pill px-3 text-foreground outline-none transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
    current && "bg-accent text-accent-foreground",
  ]}
>
  <slot />
</a>
