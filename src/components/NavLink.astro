---
interface Props {
  href: string;
  current?: boolean;
}

const { href, current = false } = Astro.props;
---

<a
  href={href}
  aria-current={current ? "page" : undefined}
  class:list={[
    "type-button inline-flex min-h-10 items-center justify-center rounded-pill px-3 outline-hidden transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
    current ? "bg-accent text-accent-foreground" : "text-foreground hover:bg-accent",
  ]}
>
  <slot />
</a>
